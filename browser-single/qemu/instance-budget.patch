+/* Positive until the first vCPU initializes, then permanently negative.
+ * A single atomic state linearizes configuration against that freeze. */
+static int instance_limit_state = MAX_INSTANCE_ALIVE;
+
+int qemu_wasm_set_instance_limit(int limit);
+EMSCRIPTEN_KEEPALIVE
+int qemu_wasm_set_instance_limit(int limit)
+{
+    if (limit != 8192 && limit != MAX_INSTANCE_ALIVE) {
+        return 0;
+    }
+    int state = qatomic_read(&instance_limit_state);
+    if (state < 0 || qatomic_cmpxchg(&instance_limit_state, state, limit) != state) {
+        return 0;
+    }
+    return limit;
+}
+
+static int freeze_instance_limit(void)
+{
+    int state = qatomic_read(&instance_limit_state);
+    while (state > 0) {
+        int observed = qatomic_cmpxchg(&instance_limit_state, state, -state);
+        if (observed == state) {
+            return state;
+        }
+        state = observed;
+    }
+    return -state;
+}
+
+static int instance_limit(void)
+{
+    int state = qatomic_read(&instance_limit_state);
+    return state < 0 ? -state : state;
+}
+
